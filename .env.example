# Connection string Postgres (di Coolify: Postgres service > Internal URL)
DATABASE_URL=postgres://postgres:PASSWORD@HOST:5432/postgres

# Akun ini otomatis mendapat role Owner.
OWNER_EMAIL=irfanef21@gmail.com

# URL publik aplikasi, dipakai untuk membuat link aktivasi email.
APP_URL=https://invopro.site

# Transactional email via Resend.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=InvoPro <noreply@invopro.site>

# Wajib 0.0.0.0 di container agar bisa diakses proxy Coolify
HOST=0.0.0.0
PORT=4321
