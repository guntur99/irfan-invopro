# Connection string Postgres (di Coolify: Postgres service > Internal URL)
DATABASE_URL=postgres://postgres:PASSWORD@HOST:5432/postgres
# Izinkan pendaftaran publik setelah user pertama (Admin). Default: ditutup.
ALLOW_SIGNUP=false
# Wajib 0.0.0.0 di container agar bisa diakses proxy Coolify
HOST=0.0.0.0
PORT=4321
